# Set to "1" to enable the mock preview login (admin/admin) and the
# developer role switcher. Leave unset in production — see
# SECURITY-PREVIEW.md for why this exists and what it does and doesn't
# protect.
NEXT_PUBLIC_VIDHATA_PREVIEW_MODE=1

# Real backend and Supabase (the /dev/upload page). Values go in .env.local, never here.
# The anon key is the publishable key, safe for the browser; never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Defaults to http://localhost:8000 when blank.
NEXT_PUBLIC_API_BASE_URL=

# Data source. Unset or anything else: the in-browser mock. "backend": the real FastAPI backend (NEXT_PUBLIC_API_BASE_URL).
# NEXT_PUBLIC_VIDHATA_DATA=backend

# Show the "Upload your contract" step on a started draft (Path 2, deferred in the SRD). Leave unset in
# production. "1" only for testing the upload and review path against the backend.
# NEXT_PUBLIC_VIDHATA_UPLOAD=1

# Google and Microsoft sign-in on /login, once each is enabled in the Supabase project
# (Authentication > Providers). "google", "azure" or "google,azure". Unset: no provider buttons.
# NEXT_PUBLIC_VIDHATA_OAUTH_PROVIDERS=google,azure

# Where people are told to write. Defaults to the company address in lib/config/company.ts.
# NEXT_PUBLIC_VIDHATA_SUPPORT_EMAIL=
